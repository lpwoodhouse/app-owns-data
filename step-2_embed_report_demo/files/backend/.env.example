# Copy to .env outside public web roots. Protect with owner-only permissions.
# Placeholder values intentionally prevent startup.
POWERBI_TENANT_ID=<TENANT_ID>
POWERBI_CLIENT_ID=<CLIENT_ID>
POWERBI_CLIENT_SECRET=<CLIENT_SECRET>
POWERBI_WORKSPACE_ID=<WORKSPACE_ID>
POWERBI_REPORT_ID=<REPORT_ID>
POWERBI_DATASET_ID=<DATASET_ID>
EMBED_USERNAME=<DEMO_USERNAME>
EMBED_PASSWORD=<RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS>
PORT=3000
