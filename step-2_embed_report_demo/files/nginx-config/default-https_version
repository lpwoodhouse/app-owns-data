# Single-user demonstration only. Provision a trusted certificate first.
server {
    listen 80;
    server_name example.com;
    return 301 https://example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name example.com;
    ssl_certificate /etc/ssl/certs/powerbi.crt;
    ssl_certificate_key /etc/ssl/private/powerbi.key;

    auth_basic "Power BI demo";
    auth_basic_user_file /etc/nginx/powerbi.htpasswd;
    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    location = /embed-info {
        proxy_pass http://127.0.0.1:3000/embed-info;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Cache-Control "no-store" always;
    }
}
